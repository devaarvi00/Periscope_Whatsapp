# ── App ───────────────────────────────────────────────────────────
APP_NAME=Hyperscope WhatsApp CRM
# development = simulated sends + /docs enabled. Use "production" for real deployments
# (startup then refuses placeholder secrets and a wildcard ALLOWED_ORIGINS).
ENVIRONMENT=development
DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-32-char-string

# ── Database (MySQL) ───────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/whatsapp_periscope
# Used by docker-compose (mysql service + app DATABASE_URL override)
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# ── MongoDB (stores chats and messages) ───────────────────────────
# Local dev without auth. Under docker-compose the app gets
# mongodb://MONGO_ROOT_USERNAME:MONGO_ROOT_PASSWORD@mongo:27017/?authSource=admin
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hyperscope
# Used by docker-compose (mongo service); keep URL-safe characters only
MONGO_ROOT_USERNAME=hyperscope
MONGO_ROOT_PASSWORD=change-me-mongo-root-password

# ── WAHA WhatsApp provider ─────────────────────────────────────────
# Run locally: docker run -it -e WHATSAPP_DEFAULT_ENGINE=WEBJS devlikeapro/waha
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION_NAME=default
WAHA_WEBHOOK_SECRET=replace-with-strong-secret

# Public URL — WAHA posts webhooks here (use ngrok for local dev)
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000

# ── Google Gemini AI ───────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Human simulation (typing indicator) ───────────────────────────
WAHA_HUMAN_SIMULATION_ENABLED=true
WAHA_TYPING_MIN_SECONDS=1.0
WAHA_TYPING_MAX_SECONDS=4.0
WAHA_TYPING_CHARS_PER_SECOND=14.0

# ── Auth ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Platform limits ────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30
BULK_MESSAGE_CREDITS_PER_MONTH=3000
MAX_AUTOMATION_RULES_PER_LICENSE=2

# ── CORS ───────────────────────────────────────────────────────────
# JSON list. "*" is rejected when ENVIRONMENT=production.
ALLOWED_ORIGINS=["http://localhost:8000"]

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
