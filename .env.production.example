# ── App ───────────────────────────────────────────────────────────
APP_NAME=Hyperscope WhatsApp CRM
ENVIRONMENT=production
DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Database (MySQL) ───────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/whatsapp_periscope

# ── MongoDB (stores chats and messages) ───────────────────────────
# URL-encode special chars in password: ^ → %5E  £ → %C2%A3  @ → %40
MONGODB_URL=mongodb://USER:PASSWORD@localhost:27017/hyperscope?authSource=admin
MONGODB_DB_NAME=hyperscope

# ── WAHA WhatsApp provider ─────────────────────────────────────────
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=REPLACE_WITH_STRONG_WAHA_KEY
# Must match the session name shown in the WAHA dashboard
WAHA_SESSION_NAME=your_session_name
WAHA_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET

# Your public domain — WAHA container POSTs webhooks here
PUBLIC_WEBHOOK_BASE_URL=https://YOUR_DOMAIN.com

# ── Google Gemini AI ───────────────────────────────────────────────
GEMINI_API_KEY=your-real-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Human simulation (typing indicator) ───────────────────────────
WAHA_HUMAN_SIMULATION_ENABLED=true
WAHA_TYPING_MIN_SECONDS=1.0
WAHA_TYPING_MAX_SECONDS=4.0
WAHA_TYPING_CHARS_PER_SECOND=14.0

# ── Auth ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Platform limits ────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30
BULK_MESSAGE_CREDITS_PER_MONTH=3000
MAX_AUTOMATION_RULES_PER_LICENSE=20

# ── CORS (restrict to your domain) ────────────────────────────────
# ALLOWED_ORIGINS=["https://YOUR_DOMAIN.com"]

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
