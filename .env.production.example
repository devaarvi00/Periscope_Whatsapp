# ── App ───────────────────────────────────────────────────────────
APP_NAME=Hyperscope WhatsApp CRM
# Must be "production": enables real sends and startup secret checks
ENVIRONMENT=production
DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Startup fails in production if this is a placeholder or shorter than 32 chars
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Database (MySQL) ───────────────────────────────────────────────
# docker-compose overrides DATABASE_URL to use the mysql service with this password
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://root:REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD@mysql:3306/whatsapp_periscope

# ── MongoDB (stores chats and messages) ───────────────────────────
# docker-compose creates the root user from these and overrides MONGODB_URL
# to point at the mongo service. Use URL-safe characters (e.g. openssl rand -hex 24).
MONGO_ROOT_USERNAME=hyperscope
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MONGO_PASSWORD
# URL-encode special chars in password: ^ → %5E  £ → %C2%A3  @ → %40
MONGODB_URL=mongodb://hyperscope:REPLACE_WITH_STRONG_MONGO_PASSWORD@mongo:27017/?authSource=admin
MONGODB_DB_NAME=hyperscope

# ── WAHA WhatsApp provider ─────────────────────────────────────────
# docker-compose overrides this to http://waha:3000
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=REPLACE_WITH_STRONG_WAHA_KEY
# Must match the session name shown in the WAHA dashboard
WAHA_SESSION_NAME=your_session_name
# At least 32 chars, e.g. openssl rand -hex 32
WAHA_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET

# Your public domain — WAHA container POSTs webhooks here
PUBLIC_WEBHOOK_BASE_URL=https://YOUR_DOMAIN.com

# ── Google Gemini AI ───────────────────────────────────────────────
GEMINI_API_KEY=your-real-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Human simulation (typing indicator) ───────────────────────────
WAHA_HUMAN_SIMULATION_ENABLED=true
WAHA_TYPING_MIN_SECONDS=1.0
WAHA_TYPING_MAX_SECONDS=4.0
WAHA_TYPING_CHARS_PER_SECOND=14.0

# ── Auth ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Platform limits ────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30
BULK_MESSAGE_CREDITS_PER_MONTH=3000
MAX_AUTOMATION_RULES_PER_LICENSE=20

# ── CORS (restrict to your domain; "*" is rejected in production) ─
ALLOWED_ORIGINS=["https://YOUR_DOMAIN.com"]

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
